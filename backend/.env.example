DATABASE_URL=sqlite:///./database.db
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
JWT_SECRET_KEY=my-super-secret-key-for-jwt-tokens-12345
ACCESS_TOKEN_EXPIRE_MINUTES=30
UPLOAD_DIR=uploads
RESULTS_DIR=results

# Object storage (MinIO locally, or any S3-compatible endpoint)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=beadbuddy
MINIO_SECURE=false

# Scheduler (backend/scheduler/dispatcher.py)
SCHEDULER_POLL_INTERVAL=2
SCHEDULER_MAX_CONCURRENT_JOBS=4
SCHEDULER_DOCKER_NETWORK=beadbuddy_default
